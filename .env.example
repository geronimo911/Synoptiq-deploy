# --- Refresh policy (production: demand-driven, no cron) ---
# 0 disables the in-process scheduler; freshness is handled on request instead.
SYNOPTIQ_AUTO_REFRESH=0
# Enables POST /api/v1/system/refresh-if-stale.
SYNOPTIQ_REFRESH_ON_REQUEST=1
# Freshness threshold in minutes (not a schedule).
SYNOPTIQ_REFRESH_MIN_AGE_MINUTES=15
SYNOPTIQ_LIVE_DATA_DIR=data/real/live_aifs_unitfix
SYNOPTIQ_HISTORY_SEED_ARCHIVE=artifacts/real_12m_aifs_corrected/seed/training_aifs_corrected.zip

