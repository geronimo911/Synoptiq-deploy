# Frontend/server gateway settings
VITE_APP_MODE=LIVE
# Public browser configuration only; never place provider or database credentials here.
VITE_API_BASE_URL=https://your-render-service.onrender.com/api/v1
# The browser calls /api/v1; the server-side gateway forwards to this backend URL.
SYNOPTIQ_API_URL=http://127.0.0.1:8000
# Optional when calling the backend directly from the browser instead of the gateway.
# VITE_API_BASE_URL=/api/v1
